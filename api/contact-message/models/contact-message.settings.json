{
  "kind": "collectionType",
  "collectionName": "contact_messages",
  "info": {
    "name": "Contact Message",
    "description": "Messages submitted from the website contact form"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": false
  },
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "mobile": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "text",
      "required": true
    },
    "isRead": {
      "type": "boolean",
      "default": false,
      "required": true
    }
  }
}
